#!/usr/bin/env bash
# Simuliertes Claude Code für Tests von draft-create.sh: schreibt eine gültige Komponente in den Versionsordner.
# Kosten wie beim echten Claude: total_cost_usd ist über die Session kumuliert (--resume setzt fort)
FAKE_COST_DIR="${TMPDIR:-/tmp}/modio-fake-claude-$(id -u)"; mkdir -p "$FAKE_COST_DIR"
fake_total() { # fake_total <kosten dieses aufrufs> -> neuer Gesamtstand der Session fake-session
  local prev=0 f="$FAKE_COST_DIR/fake-session"
  [[ "$RESUMED" == 1 && -f "$f" ]] && prev="$(cat "$f")"
  awk -v a="$prev" -v b="$1" 'BEGIN{printf "%.2f", a+b}' | tee "$f"
}
RESUMED=0; for a in "$@"; do [[ "$a" == "--resume" ]] && RESUMED=1; done
PROMPT="$(cat)"
# Für Tests: Aufrufparameter und Anmeldung protokollieren
if [[ -n "${FAKE_CLAUDE_ARGS:-}" ]]; then printf '%s\n' "$@" >"$FAKE_CLAUDE_ARGS"; echo "KEY=${ANTHROPIC_API_KEY:-}" >>"$FAKE_CLAUDE_ARGS"; printf "PROMPT:\n%s\n" "$PROMPT" >>"$FAKE_CLAUDE_ARGS"; fi
# Verwendete Variante weggelassen: die Korrekturrunde behebt nichts (Dateien bleiben, Prüfung meldet die Variante)
if [[ "${FAKE_CLAUDE_DROP_VARIANT:-}" == "1" && "$PROMPT" == "Die Prüfung von "* ]]; then
  printf '{"type":"result","is_error":false,"result":"Nichts geändert.","session_id":"fake-session","total_cost_usd":'"$(fake_total 0.01)"',"num_turns":1}\n'
  exit 0
fi
V="$(grep -oE 'v[0-9]+/' <<<"$PROMPT" | head -1 | tr -d /)"
[[ -n "$V" ]] || V=v1
# Bei einer Überarbeitung den Namen der bestehenden Komponente beibehalten
NAME="$(grep -oE 'Überarbeitung der bestehenden Komponente mx-[a-z0-9-]+' <<<"$PROMPT" | head -1 | sed 's/.*mx-//')"
[[ -n "$NAME" ]] || NAME="${FAKE_CLAUDE_NAME:-test}"
mkdir -p "$V"
if [[ "${FAKE_CLAUDE_BAD:-}" == "1" ]]; then
  printf '<div class="mx-%s"><script>x</script></div>' "$NAME" >"$V/component.html"
else
  printf '<section class="mx-%s"><h2>Neu %s</h2></section>\n' "$NAME" "$V" >"$V/component.html"
fi
printf '@scope (.mx-%s) {\n  :scope { padding: 2rem; }\n}\n' "$NAME" >"$V/component.css"
printf '[{"id":"P1","gruppe":"pflicht","titel":"Ansprache","text":"Sie-Form","umgesetzt":true}]\n' >"$V/befund.json"
printf '{"name":"%s","title":"Test","bausteine":[{"key":"layout","label":"Layout","source":"neu"}]}\n' "$NAME" >"$V/meta.json"
# Komponente für die Bibliothek: Vorlage mit Slots und zwei Varianten, component.json
if grep -q 'component.json' <<<"$PROMPT"; then
  LN="$(grep -oE 'Der Name (ist|bleibt) "[a-z0-9-]+"|Name "[a-z0-9-]+" beibehalten' <<<"$PROMPT" | head -1 | sed -E 's/[^"]*"([a-z0-9-]+)".*/\1/')"
  if [[ -n "$LN" ]]; then
    NAME="$LN"
    if [[ "${FAKE_CLAUDE_LIB_BAD:-}" == "1" ]]; then
      printf '<article class="mx-%s"><h3>Titel</h3></article>\n' "$NAME" >"$V/component.html"
    elif [[ "${FAKE_CLAUDE_LIB_WRAP:-}" == "1" ]]; then
      # geänderter Aufbau: Titel in einem Kopf, für Tests des Angleichens
      printf '<article class="mx-%s" data-mx-variant="standard"><header class="kopf"><h3 data-mx-slot="titel">Beispiel</h3></header><p data-mx-slot="text">Text</p><span class="icon" data-mx-slot="icon">★</span><a class="mehr" href="#" data-mx-slot="link">Mehr</a></article>\n' "$NAME" >"$V/component.html"
    else
      printf '<article class="mx-%s" data-mx-variant="standard"><h3 data-mx-slot="titel">Beispiel</h3><p data-mx-slot="text">Text</p><span class="icon" data-mx-slot="icon">★</span><a class="mehr" href="#" data-mx-slot="link">Mehr</a></article>\n' "$NAME" >"$V/component.html"
    fi
    printf '@scope (.mx-%s) {\n  :scope { padding: 1rem; }\n  :scope.mx-%s--hervorgehoben { background: #eee; }\n}\n' "$NAME" "$NAME" >"$V/component.css"
    printf '{"name":"%s","title":"Kachel","bausteine":[]}\n' "$NAME" >"$V/meta.json"
    printf '[]\n' >"$V/befund.json"
    printf '{"name":"%s","title":"Kachel","beschreibung":"Kachel für Übersichten.","slots":[{"key":"titel","label":"Überschrift","typ":"text"},{"key":"text","label":"Text","typ":"richtext"},{"key":"icon","label":"Icon","typ":"icon","pflicht":false},{"key":"link","label":"Link","typ":"link"}],"varianten":[{"key":"standard","label":"Standard","klassen":"","slots":["titel","text","link"]},{"key":"hervorgehoben","label":"Hervorgehoben mit Icon","klassen":"mx-%s--hervorgehoben"}]}\n' "$NAME" "$NAME" >"$V/component.json"
    # Variante hinzufügen (Entwurf auf der Komponentenseite): neue Variante aus dem Auftrag ergänzen
    NV="$(grep -oE 'Neue Variante "[a-z0-9-]+"' <<<"$PROMPT" | head -1 | sed -E 's/.*"([a-z0-9-]+)"/\1/')"
    if [[ -n "$NV" ]]; then
      jq --arg k "$NV" --arg n "$NAME" '.varianten += [{key:$k, label:"Neu", klassen:("mx-" + $n + "--" + $k)}]' "$V/component.json" >"$V/component.json.tmp" && mv "$V/component.json.tmp" "$V/component.json"
      printf '  :scope.mx-%s--%s { border: 1px solid; }\n}\n' "$NAME" "$NV" | { sed '$d' "$V/component.css"; cat; } >"$V/component.css.tmp" && mv "$V/component.css.tmp" "$V/component.css"
    fi
    if [[ "${FAKE_CLAUDE_DROP_VARIANT:-}" == "1" ]]; then jq '.varianten |= .[:1]' "$V/component.json" >"$V/component.json.tmp" && mv "$V/component.json.tmp" "$V/component.json"; fi
  fi
fi
printf '{"type":"result","is_error":false,"result":"Entwurf %s erstellt.","session_id":"fake-session","total_cost_usd":'"$(fake_total 0.01)"',"num_turns":1}\n' "$V"
