#!/usr/bin/env bash
# Simuliertes Claude Code für Tests von draft-create.sh: schreibt eine gültige Komponente in den Versionsordner.
# Kosten wie beim echten Claude: total_cost_usd ist über die Session kumuliert (--resume setzt fort)
FAKE_COST_DIR="${TMPDIR:-/tmp}/modio-fake-claude-$(id -u)"; mkdir -p "$FAKE_COST_DIR"
fake_total() { # fake_total <kosten dieses aufrufs> -> neuer Gesamtstand der Session fake-session
  local prev=0 f="$FAKE_COST_DIR/fake-session"
  [[ "$RESUMED" == 1 && -f "$f" ]] && prev="$(cat "$f")"
  awk -v a="$prev" -v b="$1" 'BEGIN{printf "%.2f", a+b}' | tee "$f"
}
RESUMED=0; for a in "$@"; do [[ "$a" == "--resume" ]] && RESUMED=1; done
PROMPT="$(cat)"
# Für Tests: Aufrufparameter und Anmeldung protokollieren
if [[ -n "${FAKE_CLAUDE_ARGS:-}" ]]; then printf '%s\n' "$@" >"$FAKE_CLAUDE_ARGS"; echo "KEY=${ANTHROPIC_API_KEY:-}" >>"$FAKE_CLAUDE_ARGS"; fi
V="$(grep -oE 'v[0-9]+/' <<<"$PROMPT" | head -1 | tr -d /)"
[[ -n "$V" ]] || V=v1
# Bei einer Überarbeitung den Namen der bestehenden Komponente beibehalten
NAME="$(grep -oE 'Überarbeitung der bestehenden Komponente mx-[a-z0-9-]+' <<<"$PROMPT" | head -1 | sed 's/.*mx-//')"
[[ -n "$NAME" ]] || NAME="${FAKE_CLAUDE_NAME:-test}"
mkdir -p "$V"
if [[ "${FAKE_CLAUDE_BAD:-}" == "1" ]]; then
  printf '<div class="mx-%s"><script>x</script></div>' "$NAME" >"$V/component.html"
else
  printf '<section class="mx-%s"><h2>Neu %s</h2></section>\n' "$NAME" "$V" >"$V/component.html"
fi
printf '@scope (.mx-%s) {\n  :scope { padding: 2rem; }\n}\n' "$NAME" >"$V/component.css"
printf '[{"id":"P1","gruppe":"pflicht","titel":"Ansprache","text":"Sie-Form","umgesetzt":true}]\n' >"$V/befund.json"
printf '{"name":"%s","title":"Test","bausteine":[{"key":"layout","label":"Layout","source":"neu"}]}\n' "$NAME" >"$V/meta.json"
printf '{"type":"result","is_error":false,"result":"Entwurf %s erstellt.","session_id":"fake-session","total_cost_usd":'"$(fake_total 0.01)"',"num_turns":1}\n' "$V"
