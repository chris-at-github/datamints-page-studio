{
  "permissions": {
    "allow": [
      "Bash(./scripts/*)",
      "Bash(scripts/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Bash(wget:*)",
      "Bash(curl:*)"
    ]
  }
}
