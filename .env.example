GIT_AUTHOR_NAME="Modio"
GIT_AUTHOR_EMAIL="modio@localhost"
GIT_COMMITTER_NAME="Modio"
GIT_COMMITTER_EMAIL="modio@localhost"
SITES_DIR=./sites
ARCHIVE_DIR=./archive
JOBS_DIR=./jobs
STATE_DIR=./state
BRIDGE_PORT=3000
MODIO_API_TOKEN=<zufälliger Wert, z. B. aus openssl rand -hex 32>
# Erlaubte Origins für die API (kommagetrennt)
MODIO_ALLOWED_ORIGINS="https://modio.ddev.site:3443,http://modio.ddev.site:3080,http://localhost:3000"
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MODEL_THOROUGH=claude-opus-5-5
CLAUDE_ALLOWED_TOOLS="Read,Edit,Write,Grep,Glob"
CLAUDE_DISALLOWED_TOOLS="Bash,WebFetch,WebSearch,Task,NotebookEdit"
CLAUDE_MAX_TURNS=30
IMAGE_MAX_COUNT=3
IMAGE_MAX_MB=10
IMAGE_MAX_PX=2000
CRAWL_USER_AGENT="Mozilla/5.0 (Modio)"
# Optional für geschützte Staging-Seiten:
# CRAWL_HTTP_USER=
# CRAWL_HTTP_PASSWORD=
# Optional, falls claude nicht im PATH des Workers liegt:
# CLAUDE_BIN=/home/<user>/.local/bin/claude
