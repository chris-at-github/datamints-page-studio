# ----- Allgemein -----
GIT_AUTHOR_NAME="datamints Page Studio"
GIT_AUTHOR_EMAIL="page-studio@localhost"
# GIT_COMMITTER_NAME/-EMAIL übernehmen ohne Angabe die Autor-Werte
SITES_DIR=./sites
ARCHIVE_DIR=./archive
JOBS_DIR=./jobs
STATE_DIR=./state

# ----- Bridge-Server -----
BRIDGE_PORT=3000
DPS_API_TOKEN=<zufälliger Wert, z. B. aus openssl rand -hex 32>
# Erlaubte Origins für die API (kommagetrennt)
DPS_ALLOWED_ORIGINS="https://datamints-page-studio.ddev.site:3443,http://datamints-page-studio.ddev.site:3080,http://localhost:3000"

# ----- Claude: Anmeldung -----
# konto = Claude-Konto (Abo); ANTHROPIC_API_KEY wird dem Aufruf entzogen, abgerechnet wird über das Konto
# api   = API-Schlüssel (ANTHROPIC_API_KEY oder apiKeyHelper in CLAUDE_SETTINGS_FILE), Aufruf mit --bare
CLAUDE_AUTH=konto
# Nur bei CLAUDE_AUTH=api:
# ANTHROPIC_API_KEY=
CLAUDE_SETTINGS_FILE=./tools/worker/claude-settings.json
# Optional, falls claude nicht im PATH des Workers liegt:
# CLAUDE_BIN=/home/<user>/.local/bin/claude

# ----- Claude: Modell und Effort -----
# Effort: low | medium | high | xhigh | max
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
# Modell bei „gründlich“ (leer = CLAUDE_MODEL; sinnvoll, wenn CLAUDE_MODEL z. B. Sonnet ist)
CLAUDE_MODEL_THOROUGH=
# Entwürfe abweichend einstellen (leer = CLAUDE_MODEL / CLAUDE_EFFORT)
DRAFT_MODEL=
DRAFT_EFFORT=

# ----- Claude: Grenzen -----
# Kosten pro Lauf in USD (leer oder 0 = ohne Obergrenze)
CLAUDE_MAX_BUDGET_USD=1.50
DRAFT_MAX_BUDGET_USD=4.00
# Abbruch nach Sekunden (alle Läufe) bzw. Zügen (Annotationen; leer = ohne Grenze)
CLAUDE_TIMEOUT=1200
CLAUDE_MAX_TURNS=30
CLAUDE_ALLOWED_TOOLS="Read,Edit,Write,Grep,Glob"
CLAUDE_DISALLOWED_TOOLS="Bash,WebFetch,WebSearch,Task,NotebookEdit"

# ----- Kontext für Claude -----
CONTEXT_HISTORY_COUNT=5
NOTES_MAX_LINES=40

# ----- Referenzbilder -----
IMAGE_MAX_COUNT=3
IMAGE_MAX_MB=10
IMAGE_MAX_PX=2000

# ----- Abzug -----
CRAWL_USER_AGENT="Mozilla/5.0 (datamints Page Studio)"
# Optional für geschützte Staging-Seiten:
# CRAWL_HTTP_USER=
# CRAWL_HTTP_PASSWORD=

# ----- Design -----
# Skill „frontend-design“: nicht gesetzt = Standardpfad im Plugin-Ordner, leer = ohne Skill
# DESIGN_SKILL_FILE=
# Gestaltungs-Skills im Systemprompt (Reihenfolge = Rangfolge, nachrangig zu den Leitlinien)
# Eintrag: <skill>[:<referenz.md>,…] oder absoluter Pfad zu einer SKILL.md; leer = ohne Skills
# DESIGN_SKILLS="impeccable:craft-floor.md frontend-design"   # Standard, wenn nicht gesetzt
# DESIGN_SKILLS_ANNOTATION=                       # eigene Liste nur für Annotationen (leer = ohne Skill)
# DESIGN_SKILLS_DRAFT=                            # eigene Liste nur für Entwürfe
# DESIGN_SKILL_FILE=/pfad/zu/SKILL.md             # älter: gilt nur, solange DESIGN_SKILLS nicht gesetzt ist

DESIGN_DOCS_MAX_BYTES=60000

# Gestaltungsprüfung nach Annotationen und Entwürfen (Detektor des Skills impeccable)
DESIGN_CHECK=on                                   # on | off
DESIGN_CHECK_VIEWPORTS=desktop:1440x900,mobil:390x844
# IMPECCABLE_CMD=./.claude/skills/impeccable/scripts/impeccable
# IMPECCABLE_BROWSER=/pfad/zu/chrome              # sonst PLAYWRIGHT_CHROMIUM bzw. das Chromium von Playwright