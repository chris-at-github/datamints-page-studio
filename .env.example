# ----- Allgemein -----
GIT_AUTHOR_NAME="Modio"
GIT_AUTHOR_EMAIL="modio@localhost"
# GIT_COMMITTER_NAME/-EMAIL übernehmen ohne Angabe die Autor-Werte
SITES_DIR=./sites
ARCHIVE_DIR=./archive
JOBS_DIR=./jobs
STATE_DIR=./state

# ----- Bridge-Server -----
BRIDGE_PORT=3000
MODIO_API_TOKEN=<zufälliger Wert, z. B. aus openssl rand -hex 32>
# Erlaubte Origins für die API (kommagetrennt)
MODIO_ALLOWED_ORIGINS="https://modio.ddev.site:3443,http://modio.ddev.site:3080,http://localhost:3000"

# ----- Claude: Anmeldung -----
# konto = Claude-Konto (Abo); ANTHROPIC_API_KEY wird dem Aufruf entzogen, abgerechnet wird über das Konto
# api   = API-Schlüssel (ANTHROPIC_API_KEY oder apiKeyHelper in CLAUDE_SETTINGS_FILE), Aufruf mit --bare
CLAUDE_AUTH=konto
# Nur bei CLAUDE_AUTH=api:
# ANTHROPIC_API_KEY=
CLAUDE_SETTINGS_FILE=./tools/worker/claude-settings.json
# Optional, falls claude nicht im PATH des Workers liegt:
# CLAUDE_BIN=/home/<user>/.local/bin/claude

# ----- Claude: Modell und Effort -----
# Effort: low | medium | high | xhigh | max
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
# Modell bei „gründlich“ (leer = CLAUDE_MODEL; sinnvoll, wenn CLAUDE_MODEL z. B. Sonnet ist)
CLAUDE_MODEL_THOROUGH=
# Entwürfe abweichend einstellen (leer = CLAUDE_MODEL / CLAUDE_EFFORT)
DRAFT_MODEL=
DRAFT_EFFORT=

# ----- Claude: Grenzen -----
# Kosten pro Lauf in USD (leer oder 0 = ohne Obergrenze)
CLAUDE_MAX_BUDGET_USD=1.50
DRAFT_MAX_BUDGET_USD=4.00
# Abbruch nach Sekunden (alle Läufe) bzw. Zügen (Annotationen; leer = ohne Grenze)
CLAUDE_TIMEOUT=1200
CLAUDE_MAX_TURNS=30
CLAUDE_ALLOWED_TOOLS="Read,Edit,Write,Grep,Glob"
CLAUDE_DISALLOWED_TOOLS="Bash,WebFetch,WebSearch,Task,NotebookEdit"

# ----- Kontext für Claude -----
CONTEXT_HISTORY_COUNT=5
NOTES_MAX_LINES=40
DESIGN_DOCS_MAX_BYTES=60000
# Skill „frontend-design“: nicht gesetzt = Standardpfad im Plugin-Ordner, leer = ohne Skill
# DESIGN_SKILL_FILE=

# ----- Referenzbilder -----
IMAGE_MAX_COUNT=3
IMAGE_MAX_MB=10
IMAGE_MAX_PX=2000

# ----- Abzug -----
CRAWL_USER_AGENT="Mozilla/5.0 (Modio)"
# Optional für geschützte Staging-Seiten:
# CRAWL_HTTP_USER=
# CRAWL_HTTP_PASSWORD=
